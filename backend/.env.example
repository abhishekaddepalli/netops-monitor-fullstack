APP_NAME="NetOps Monitor"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000
APP_LOCALE=en

# ── Database ──────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=netops_monitor
DB_USERNAME=netops
DB_PASSWORD=

# ── Cache / Session / Queue (Redis recommended) ──────────
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

# ── Broadcasting (WebSocket real-time updates) ───────────
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1

# ── Mail ──────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="alerts@netopsmonitor.in"
MAIL_FROM_NAME="${APP_NAME}"

# ── Monitoring Engine ─────────────────────────────────────
MONITOR_DEFAULT_TIMEOUT_SECONDS=30
MONITOR_FAILURES_BEFORE_INCIDENT=3
MONITOR_CONFIRMATIONS_BEFORE_RESOLVE=2
MONITOR_DEFAULT_NODE=mumbai-1
MONITOR_QUEUE=monitor-checks
MONITOR_QUEUE_HIGH_PRIORITY=monitor-checks-fast

# ── SSL/Domain Expiry ──────────────────────────────────────
SSL_CHECK_HOUR=2

# ── Alerting Channels ──────────────────────────────────────
TELEGRAM_BOT_TOKEN=
SLACK_WEBHOOK_DEFAULT=
DISCORD_WEBHOOK_DEFAULT=
WHATSAPP_PROVIDER=twilio
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
MSG91_AUTH_KEY=
GUPSHUP_API_KEY=

# ── Billing ───────────────────────────────────────────────
RAZORPAY_KEY=
RAZORPAY_SECRET=
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# ── Sanctum / API ────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000
SESSION_DOMAIN=localhost

# ── Multi-region monitoring nodes (comma separated node keys) ──
MONITOR_NODES=mumbai-1,hyderabad-1,singapore-1,london-1,frankfurt-1,newyork-1
